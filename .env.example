# ==========================================
# LLM CONFIGURATION (SWITCH PROVIDER HERE)
# ==========================================
# Supported: "groq" | "openai" | "ollama"
LLM_PROVIDER=groq

# Active Model: openai/gpt-oss-20b | openai/gpt-oss-120b | llama-3.3-70b-versatile
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0

# API Keys (Get free Groq key from https://console.groq.com/keys)
GROQ_API_KEY=your_free_groq_api_key_here
OPENAI_API_KEY=your_optional_openai_key_here

# ==========================================
# EMBEDDING CONFIGURATION & VERSIONING
# ==========================================
# Supported: "local" (Free HuggingFace BAAI models) | "openai"
EMBEDDING_PROVIDER=local
# Local Model: BAAI/bge-small-en-v1.5 (Low RAM, ~350MB) or BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# Versioned Collection Name (Allows collection switching with 0 downtime)
VECTOR_COLLECTION_NAME=compliance_bge_m3_v1

# ==========================================
# SYSTEM & STORAGE PATHS
# ==========================================
SQLITE_DB_PATH=data/compliance_master.db
CHROMA_DB_PATH=data/chroma_storage

# Chunking Strategy (Decoupled Parent-Child)
CHUNK_CHILD_SIZE=200
CHUNK_CHILD_OVERLAP=50
CHUNK_PARENT_SIZE=1200

# Background Job Timeout
INGESTION_TIMEOUT_SECONDS=600
