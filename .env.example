# ==============================================================================
# BANKING REGULATORY COMPLIANCE RAG ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 1. LLM CONFIGURATION (GENERATION ENGINE)
# ==============================================================================
# Supported Providers: "groq" (Recommended, ultra-fast) | "openai" | "ollama"
LLM_PROVIDER=groq

# Active Model:
# - Groq: openai/gpt-oss-20b | llama-3.3-70b-versatile | deepseek-r1-distill-llama-70b
# - OpenAI: gpt-4o | gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0

# LLM API Keys (Get free Groq key from https://console.groq.com/keys)
GROQ_API_KEY=your_free_groq_api_key_here
OPENAI_API_KEY=your_optional_openai_key_here

# ==============================================================================
# 2. EMBEDDINGS & VECTOR ENGINES (BAAI/BGE-M3)
# ==============================================================================
# Supported: "local" (HuggingFace open-source) | "openai"
EMBEDDING_PROVIDER=local

# Model Selection:
# - BAAI/bge-m3:
#     * Vector Dimensions: 1024 (vs 384 for bge-small)
#     * Context Window: 8,192 tokens (16x larger than bge-small's 512 tokens)
#     * Best for banking/legal text: captures entire clauses with high semantic precision
# - BAAI/bge-small-en-v1.5: Low RAM (~350MB, 384 dims, 512 context)
EMBEDDING_MODEL=BAAI/bge-m3
# Device for PyTorch tensor computation: "cpu" (recommended for Cloud Run) | "cuda"
EMBEDDING_DEVICE=cpu

# Batch Size for Generating Embeddings:
# - For local 8GB RAM laptop: set to 32 or 64 (balanced memory usage)
# - For GCP Cloud Run (2-4 vCPUs, 4GB RAM): set to 128 or 256 (5x-10x faster batch ingestion)
EMBEDDING_BATCH_SIZE=64

# Versioned Vector Collection Name:
# NOTE: BGE-M3 produces 1024-dimensional vectors. When switching from BGE-small (384-d),
# changing the collection name ensures zero-downtime and prevents dimension mismatch errors.
VECTOR_COLLECTION_NAME=compliance_bge_m3_v2

# ==============================================================================
# 3. CHUNKING & CONTEXT WINDOW BUDGETING (PARENT-CHILD RETRIEVAL)
# ==============================================================================
# Tuned specifically for BAAI/bge-m3 (8,192 context window):
# - CHUNK_CHILD_SIZE: 500 tokens (increased from 200). Captures entire legal sub-clauses,
#   statutory definitions, and compliance rules in a single vector without fragmentation.
# - CHUNK_CHILD_OVERLAP: 80 tokens (ensures sentence boundaries and references are preserved).
CHUNK_CHILD_SIZE=500
CHUNK_CHILD_OVERLAP=80

# --- Context Window Budgeting Based on LLM Provider ---
#
# Scenario A: Using GROQ FREE TIER (e.g., openai/gpt-oss-20b or llama-3.3-70b-versatile)
#   * Groq context capacity: 128,000 tokens (HUGE - no context overflow risk).
#   * Groq Free-Tier Rate Limit: ~6,000 Tokens Per Minute (TPM).
#   * RECOMMENDED SETTINGS for Groq Free Tier:
#       CHUNK_PARENT_SIZE=1500
#       TOP_PARENT_CONTEXTS=3
#       -> Total prompt: 3 * 1500 ≈ 4,500 tokens. Fits 100% inside Groq's 6,000 TPM limit!
#
# Scenario B: Using PAID LLMs (e.g., Paid Groq, OpenAI GPT-4o, Anthropic, or Local Ollama)
#   * Paid limits: 200,000+ TPM (virtually unlimited).
#   * RECOMMENDED SETTINGS for Paid Providers:
#       CHUNK_PARENT_SIZE=2500
#       TOP_PARENT_CONTEXTS=5
#       -> Total prompt: 5 * 2500 ≈ 12,500 tokens of full statutory schedules and deep context.
#
CHUNK_PARENT_SIZE=1500
TOP_PARENT_CONTEXTS=3

# ==============================================================================
# 4. STORAGE & DATABASE CONFIGURATION
# ==============================================================================
# Local Development Paths (Default):
SQLITE_DB_PATH=data/compliance_master.db
CHROMA_DB_PATH=data/chroma_storage

# Supabase Cloud Database (Uncomment when connecting to Supabase):
# Use port 6543 (PgBouncer Transaction Pooler) for Cloud Run serverless scalability.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# ==============================================================================
# 5. INGESTION, TIMEOUTS & SECURITY
# ==============================================================================
INGESTION_TIMEOUT_SECONDS=600
# Maximum upload file size in MB (50 MB protects Supabase Free Tier 500 MB database quota)
MAX_UPLOAD_SIZE_MB=50

# Rate Limiting (slowapi)
RATE_LIMIT_QUERY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# ==============================================================================
# 6. DEPLOYMENT & PRODUCTION GATEKEEPER
# ==============================================================================
# PROD_MODE: "Y" = Production Mode (strictly blocks requests from localhost / 127.0.0.1)
#            "N" = Local Development Mode (accepts local requests)
PROD_MODE=N

